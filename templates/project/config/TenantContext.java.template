package {{PACKAGE}}.config;

import java.util.UUID;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.slf4j.MDC;

/**
 * Contexto de Tenant multi-hilo basado en ThreadLocal.
 * Mantiene el esquema del tenant activo, subdominio, ID de usuario y sincroniza con MDC de SLF4J para trazabilidad en logs.
 */
public class TenantContext {

    private static final Logger log = LoggerFactory.getLogger(TenantContext.class);
    private static final ThreadLocal<String> CURRENT_TENANT = new ThreadLocal<>();
    private static final ThreadLocal<String> CURRENT_SUBDOMAIN = new ThreadLocal<>();
    private static final ThreadLocal<UUID> CURRENT_USER_ID = new ThreadLocal<>();

    public static void setTenantSchema(String tenantSchema) {
        log.debug("Estableciendo esquema de tenant: {}", tenantSchema);
        CURRENT_TENANT.set(tenantSchema);
        updateMdc("tenantSchema", tenantSchema);
    }

    public static String getTenantSchema() {
        return CURRENT_TENANT.get();
    }

    public static void setSubdominio(String subdominio) {
        CURRENT_SUBDOMAIN.set(subdominio);
        updateMdc("subdominio", subdominio);
    }

    public static String getSubdominio() {
        return CURRENT_SUBDOMAIN.get();
    }

    public static void setUsuarioId(UUID usuarioId) {
        CURRENT_USER_ID.set(usuarioId);
        updateMdc("usuarioId", usuarioId != null ? usuarioId.toString() : null);
    }

    public static UUID getUsuarioId() {
        return CURRENT_USER_ID.get();
    }

    private static void updateMdc(String key, String value) {
        if (value != null && !value.isBlank()) {
            MDC.put(key, value);
        } else {
            MDC.remove(key);
        }
    }

    public static void clear() {
        CURRENT_TENANT.remove();
        CURRENT_SUBDOMAIN.remove();
        CURRENT_USER_ID.remove();

        MDC.remove("tenantSchema");
        MDC.remove("subdominio");
        MDC.remove("usuarioId");
    }

    public static TenantSnapshot capture() {
        return new TenantSnapshot(
            CURRENT_TENANT.get(),
            CURRENT_SUBDOMAIN.get(),
            CURRENT_USER_ID.get(),
            MDC.get("correlationId")
        );
    }

    public static void restore(TenantSnapshot snapshot) {
        if (snapshot == null) {
            clear();
            return;
        }
        setTenantSchema(snapshot.tenantSchema());
        setSubdominio(snapshot.subdominio());
        setUsuarioId(snapshot.usuarioId());
        if (snapshot.correlationId() != null && !snapshot.correlationId().isBlank()) {
            MDC.put("correlationId", snapshot.correlationId());
        } else {
            MDC.remove("correlationId");
        }
    }
}
