services:
  {{service}}-backend-dev:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: {{service}}_backend_dev
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      - DB_HOST={{service}}-postgres-dev
      - DB_PORT=5432
      - DB_NAME={{service}}_db
      - DB_USER=postgres
      - DB_PASSWORD=postgres
      - JWT_PRIVATE_KEY_PATH=file:/app/certs/private_key.pem
      - JWT_PUBLIC_KEY_PATH=file:/app/certs/public_key.pem
    ports:
      - "8080:8080"
    volumes:
      - ./certs:/app/certs:ro
    depends_on:
      {{service}}-postgres-dev:
        condition: service_healthy

  {{service}}-postgres-dev:
    image: postgres:16-alpine
    container_name: {{service}}_postgres_dev
    environment:
      - POSTGRES_DB={{service}}_db
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=postgres
    ports:
      - "5432:5432"
    volumes:
      - pgdata-dev:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{service}}_db"]
      interval: 5s
      timeout: 5s
      retries: 5

volumes:
  pgdata-dev:
